rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }
    match /courses/{courseId} {
      allow read: if resource.data.access == 'public' || (signedIn() && (resource.data.access == 'member' || isAdmin()));
      allow write: if isAdmin();
    }
    match /courses/{courseId}/modules/{moduleId} { allow read: if signedIn() || isAdmin(); allow write: if isAdmin(); }
    match /courses/{courseId}/modules/{moduleId}/lessons/{lessonId} { allow read: if signedIn() || isAdmin(); allow write: if isAdmin(); }
    match /progress/{progressId} { allow read, write: if signedIn() && (request.auth.uid == resource.data.userId || request.resource.data.userId == request.auth.uid || isAdmin()); }
    match /entitlements/{entitlementId} { allow read: if signedIn() && (request.auth.uid == resource.data.userId || isAdmin()); allow write: if isAdmin(); }
    match /announcements/{id} { allow read: if resource.data.published == true || isAdmin(); allow write: if isAdmin(); }
    match /notifications/{id} { allow read: if signedIn() && request.auth.uid == resource.data.userId; allow write: if isAdmin(); }
    match /auditLogs/{id} { allow read, write: if isAdmin(); }
  }
}

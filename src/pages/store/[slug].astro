---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/site.js';
export function getStaticPaths(){ return products.map(product => ({params:{slug:product.slug},props:{product}})); }
const { product } = Astro.props;
const base = import.meta.env.BASE_URL;
const related = products.filter(p => p.slug !== product.slug && (p.category === product.category || p.platforms.some(x => product.platforms.includes(x)))).slice(0,3);
---
<BaseLayout title={`${product.name} — Trade Avata`} description={product.description}>
<section class="page-hero"><div class="container product-detail-hero"><div><span class="eyebrow">{product.type} · {product.availability}</span><h1>{product.name}</h1><p>{product.description}</p><div class="product-detail-actions"><span class="price-large">{product.priceLabel}</span>{product.courseSlug ? <a class="button" href={`${base}learn/${product.courseSlug}`}>Open course →</a> : <a class="button" href={`${base}register`}>Get updates →</a>}</div></div><div class="product-detail-art"><strong>{product.platforms.join(' · ')}</strong><span>Trade Avata</span></div></div></section>
<section class="section"><div class="container detail-grid"><div><span class="eyebrow">Overview</span><h2>Built for a simpler workflow.</h2><p>{product.description}</p><h3>Features</h3><ul class="feature-list">{product.included.map(x => <li>{x}</li>)}</ul></div><aside class="detail-side"><div><strong>Supported platforms</strong><p>{product.platforms.join(', ')}</p></div><div><strong>Devices</strong><p>{product.devices.join(', ')}</p></div><div><strong>Version</strong><p>{product.version}</p></div><div><strong>Requirements</strong><p>{product.requirements}</p></div></aside></div></section>
<section class="section section-soft"><div class="container"><span class="eyebrow">Product information</span><div class="cards info-cards"><article class="card"><h3>What's included</h3><ul>{product.included.map(x=><li>{x}</li>)}</ul></article><article class="card"><h3>Installation</h3><p>Installation instructions and documentation will be provided with the product when it becomes available.</p></article><article class="card"><h3>Version history</h3><p>Current version: {product.version}. Changelog entries can be managed from the Product Manager.</p></article></div></div></section>
{related.length>0 && <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Related</span><h2>You may also explore.</h2></div></div><div class="cards">{related.map(p=><article class="card"><span class="pill">{p.type}</span><h3>{p.name}</h3><p>{p.short}</p><a class="text-link" href={`${base}store/${p.slug}`}>View product →</a></article>)}</div></div></section>}
</BaseLayout>

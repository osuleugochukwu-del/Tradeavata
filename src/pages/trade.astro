---
import BaseLayout from '../layouts/BaseLayout.astro';
import { indicators } from '../data/site.js';
---
<BaseLayout title="Trade — Trade Avata"><section class="page-hero"><div class="container"><span class="eyebrow">Trade</span><h1>Tools for the trading side.</h1><p>Indicators, charts and market resources designed to support a disciplined workflow. Product access will be enforced through user entitlements.</p></div></section><section class="section"><div class="container"><div class="cards">{indicators.map(i => <article class="card"><span class="pill">{i.status}</span><h3>{i.name}</h3><p>{i.description}</p><div class="meta"><span>{i.platform}</span><span>Documentation</span></div><a class="button button-small" href={`${import.meta.env.BASE_URL}trade#${i.slug}`}>View details</a></article>)}<article class="card"><div class="icon-box">TV</div><h3>Charts & market view</h3><p>Chart embeds and market context can be connected without making the core site heavy.</p><a class="button button-small" href={`${import.meta.env.BASE_URL}tools`}>Open tools</a></article></div></div></section></BaseLayout>

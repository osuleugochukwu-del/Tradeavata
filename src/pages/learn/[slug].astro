---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { courses, beginnerModules } from '../../data/site.js';
export function getStaticPaths(){ return courses.map(course => ({params:{slug:course.slug},props:{course}})); }
const { course } = Astro.props;
const modules = course.slug === 'trading-for-complete-beginners' ? beginnerModules : beginnerModules.slice(0, Math.min(8, course.modules));
---
<BaseLayout title={`${course.title} — Trade Avata`} description={course.description}>
  <section class="page-hero"><div class="container"><span class="pill">{course.access}</span><h1>{course.title}</h1><p>{course.description}</p><div class="meta"><span>{course.modules} modules</span><span>{course.lessons} lessons</span><span>{course.duration}</span><span>{course.progression}</span></div><div class="actions"><a class="button" href={`${import.meta.env.BASE_URL}register`}>Register to start →</a><a class="button button-outline" href={`${import.meta.env.BASE_URL}login`}>I already have an account</a></div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Course map</span><h2>Structured for progress.</h2><p>Lessons can use Vimeo embeds, completion rules and sequential unlocking without storing large video files on the website.</p></div></div><div class="module-list">{modules.map(m => <details class="module-card"><summary><span><b>{m.number}</b>{m.title}</span><small>{m.lessons.length} lessons</small></summary><div class="lesson-list">{m.lessons.map((lesson, i) => <div class="lesson-row"><span>{String(i+1).padStart(2,'0')}</span><strong>{lesson}</strong><em>Locked until access</em></div>)}</div></details>)}</div></div></section>
</BaseLayout>

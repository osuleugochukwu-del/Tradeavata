---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Dashboard — Trade Avata"><section class="dashboard"><div class="container dash-grid"><aside class="sidebar"><a class="active" href={`${import.meta.env.BASE_URL}dashboard`}>Overview</a><a href="#courses">My courses</a><a href="#indicators">Indicators</a><a href="#certificates">Certificates</a><a href="#notifications">Notifications</a><a href="#settings">Settings</a></aside><div class="dash-content"><span class="eyebrow">Member area</span><h1>Welcome back.</h1><p class="muted">Your live dashboard will read course access, progress and notifications from Firebase.</p><div class="card" id="courses"><div class="section-head"><div><h3>Continue learning</h3><p>Trading for Complete Beginners</p></div><strong>0%</strong></div><div class="progress"><span style="width:0%"></span></div><div class="actions"><a class="button button-small" href={`${import.meta.env.BASE_URL}learn/trading-for-complete-beginners`}>Open course</a></div></div><div class="cards" style="margin-top:18px"><div class="card" id="indicators"><span class="pill">Indicators</span><h3>My indicators</h3><p>Your entitled products will appear here.</p></div><div class="card" id="certificates"><span class="pill">Certificates</span><h3>Achievements</h3><p>Completed courses and verified certificates will appear here.</p></div><div class="card" id="notifications"><span class="pill">Notifications</span><h3>Stay updated</h3><p>New lessons, announcements and access reminders will appear here.</p></div></div></div></div></section></BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { courses, products, site } from '../data/site.js';
---
<BaseLayout title={`${site.name} — ${site.tagline}`} description={site.description}>
  <section class="hero"><div class="container hero-grid"><div><span class="eyebrow">Products · Technology · Education</span><h1>Trade <span>Simple.</span></h1><p>Trade Avata builds practical tools, applications, products, resources and education that make trading simpler — for beginners and experienced traders alike.</p><div class="actions"><a class="button" href={`${import.meta.env.BASE_URL}store`}>Explore products →</a><a class="button button-outline" href={`${import.meta.env.BASE_URL}learn`}>Start learning</a></div></div><div class="hero-visual" aria-label="Abstract rising market line"><div class="floating-card one"><small>LEARNING PATH</small><strong>Beginner → Trader</strong></div><div class="chart-line"></div><div class="floating-card two"><small>RISK FIRST</small><strong>Plan before entry</strong></div></div></div></section>
  <section class="section"><div class="container"><div class="announcement"><div><strong>Trade Avata — Trade Simple.</strong><p>A company building useful trading technology, products, applications, tools and education — organized around simplicity.</p></div><a class="button button-light" href={`${import.meta.env.BASE_URL}learn`}>Explore learning →</a></div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Learn</span><h2>Learn without unnecessary complexity.</h2><p>Structured education is one part of Trade Avata. Start with a clear path, then explore the tools and products that support your workflow.</p></div><a class="text-link" href={`${import.meta.env.BASE_URL}learn`}>View all courses →</a></div><div class="cards">{courses.map(c => <article class="card course-card"><div class="course-cover"><span>{c.level}</span></div><span class="pill">{c.access}</span><h3>{c.title}</h3><p>{c.description}</p><div class="meta"><span>{c.modules} modules</span><span>{c.lessons} lessons</span><span>{c.duration}</span></div><a class="button button-small" href={`${import.meta.env.BASE_URL}learn/${c.slug}`}>View course</a></article>)}</div></div></section>
  <section class="section section-soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Products & Technology</span><h2>The right tools can make trading simpler.</h2><p>Explore indicators, applications, calculators and future products across the platforms you already use.</p></div><a class="text-link" href={`${import.meta.env.BASE_URL}store`}>View marketplace →</a></div><div class="cards"><div class="card"><div class="icon-box">01</div><h3>Products</h3><p>Indicators, applications, digital products and technology across multiple platforms.</p><a class="text-link" href={`${import.meta.env.BASE_URL}store`}>Explore products →</a></div><div class="card"><div class="icon-box">02</div><h3>Tools</h3><p>Calculators and utilities designed to remove unnecessary manual work from your process.</p><a class="text-link" href={`${import.meta.env.BASE_URL}tools`}>Open tools →</a></div><div class="card"><div class="icon-box">03</div><h3>Trade</h3><p>Charts, market context, watchlists and trading workspace features can grow here over time.</p><a class="text-link" href={`${import.meta.env.BASE_URL}trade`}>Explore Trade →</a></div></div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Built for growth</span><h2>One company. Room for what comes next.</h2><p>Trade Avata is not locked into one product or one business model. New technologies, applications, services and solutions can be added without rebuilding the company foundation.</p></div></div><div class="stats"><div class="stat"><strong>0</strong><span>Members at launch</span></div><div class="stat"><strong>12</strong><span>Beginner modules prepared</span></div><div class="stat"><strong>60</strong><span>Beginner lessons planned</span></div><div class="stat"><strong>4</strong><span>Core business areas</span></div></div></div></section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Create account — Trade Avata"><section class="section"><div class="container"><div class="form-card"><span class="eyebrow">Get started</span><h1>Create your account.</h1><p>Start with a simple account. Your course access and progress can follow you across devices.</p><form id="register-form"><label for="name">Name</label><input id="name" name="name" type="text" autocomplete="name" required placeholder="Your name" /><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" /><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="6" required placeholder="Create a password" /><button class="button" type="submit">Create account</button><p id="auth-message" class="form-message" aria-live="polite"></p></form><p><a class="text-link" href={`${import.meta.env.BASE_URL}login`}>Already a member? Log in →</a></p></div></div></section><script type="module" src="/auth.js"></script></BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products, courses } from '../data/site.js';
---
<BaseLayout title="Admin — Trade Avata"><section class="dashboard"><div class="container"><span class="eyebrow">Administration</span><h1>Company control centre.</h1><p>Manage the Trade Avata ecosystem from one backend: products, courses, members, access, announcements and future business lines.</p><div class="admin-grid" style="margin-top:28px"><div class="admin-stat"><strong>0</strong><span>Members</span></div><div class="admin-stat"><strong>{products.length}</strong><span>Products in catalogue</span></div><div class="admin-stat"><strong>{courses.length}</strong><span>Courses</span></div><div class="admin-stat"><strong>0</strong><span>Orders</span></div></div><div class="section-head" style="margin-top:42px"><div><span class="eyebrow">Product Manager</span><h2>One catalogue. Many platforms.</h2><p>The production version should store these fields in Firebase so administrators can create, edit, publish and retire products without changing source code.</p></div></div><div class="admin-product-list">{products.map(p=><div class="admin-product-row"><div><strong>{p.name}</strong><span>{p.type} · {p.category}</span></div><div class="admin-platforms">{p.platforms.map(x=><span class="pill">{x}</span>)}</div><span>{p.availability}</span><button class="button button-small button-outline" type="button">Edit</button></div>)}</div><div class="cards" style="margin-top:18px"><div class="card"><h3>Products</h3><p>Create products, assign multiple platforms, set pricing, availability, screenshots, video, requirements, versions, documentation, related products and entitlements.</p></div><div class="card"><h3>Courses</h3><p>Create, schedule, publish, reorder modules, attach Vimeo lessons and manage progression.</p></div><div class="card"><h3>Users & access</h3><p>Roles, bans, entitlements, temporary access and member support.</p></div><div class="card"><h3>Announcements</h3><p>Reusable homepage announcements, campaigns and countdowns.</p></div><div class="card"><h3>Company settings</h3><p>Keep future product lines and business areas configurable rather than hard-coded into the public navigation.</p></div><div class="card"><h3>Security & audit</h3><p>Role permissions, protected operations and records of important administrative actions.</p></div></div></div></section></BaseLayout>

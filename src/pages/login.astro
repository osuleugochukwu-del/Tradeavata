---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Log in — Trade Avata"><section class="section"><div class="container"><div class="form-card"><span class="eyebrow">Member access</span><h1>Welcome back.</h1><p>Sign in to access your Trade Avata products, tools and learning.</p><form id="login-form"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" /><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required placeholder="••••••••" /><button class="button" type="submit">Log in</button><p id="auth-message" class="form-message" aria-live="polite"></p></form><p><a class="text-link" href={`${import.meta.env.BASE_URL}register`}>Need an account? Create one →</a></p></div></div></section><script type="module" src="/auth.js"></script></BaseLayout>
